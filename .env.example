# STRYQ Environment Variables for Vercel Deployment

# 1. MongoDB Atlas Connection String (Required)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stryq?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# 2. JWT Secret Key (Required - any secure random string)
JWT_SECRET=stryq_production_jwt_secret_key_random_string_12345

# 3. App Public URL (Optional)
NEXT_PUBLIC_APP_URL=https://your-stryq-app.vercel.app

